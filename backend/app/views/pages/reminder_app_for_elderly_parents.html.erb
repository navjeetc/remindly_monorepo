  <% if current_user %>
    <a class="btn btn-primary" href="<%= dashboard_path %>">Go to your dashboard</a>
  <% else %>
    <a class="btn btn-primary" href="<%= login_path %>">Set up reminders for my parent — free</a>
  <% end %>
