<%# The empty state carries its own call to action, so the header repeats it
    whenever it is on screen — two identical blue buttons, one explained and one
    not. Computed once here rather than twice, because the duplication only
    became visible when both happened to say the same words. %>
<%# exists? rather than includes(...).empty?, which was carried over from the
    inline condition this replaced. Both emit the same SELECT 1 ... LIMIT 1 — the
    includes is dropped, not honoured — so it read as though the association
    were being loaded while doing nothing at all. %>
<% no_caregivers_yet = current_user.role_senior? &&
     !current_user.senior_links.where.not(caregiver_id: nil).exists? %>
<% showing_empty_state = @linked_seniors.empty? && (current_user.role_caregiver? || no_caregivers_yet) %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-3xl font-bold text-gray-900">
      <%= current_user.role_senior? ? "My Dashboard" : "Caregiver Dashboard" %>
    </h2>
    <div class="flex flex-wrap gap-3">
      <% if current_user.role_senior? && !showing_empty_state %>
        <%= link_to "Generate Pairing Token", generate_token_dashboard_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
      <% end %>
      <% if current_user.role_caregiver? %>
        <% unless showing_empty_state %>
          <%= link_to "Pair with a care receiver", pair_dashboard_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
        <% end %>
        <% if FeatureFlag.enabled?(:native_scheduling) %>
          <%= link_to "My Availability", caregiver_availabilities_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <% end %>
        <% if Rails.env.development? %>
          <%= button_to "🔧 Check Coverage Gaps", trigger_coverage_check_dev_path, method: :post, class: "inline-flex items-center px-4 py-2 border border-yellow-300 text-sm font-medium rounded-md text-yellow-800 bg-yellow-50 hover:bg-yellow-100" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @pending_links.any? %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-yellow-700">
            You have <%= pluralize(@pending_links.count, 'pending pairing request') %>. Share the token with your caregiver.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Care receiver's upcoming tasks -->
  <% if current_user.role_senior? && defined?(@upcoming_tasks) && @upcoming_tasks.present? %>
    <div class="bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Upcoming Tasks (Next 30 Days)</h3>
        </div>
        <div class="space-y-3">
          <% @upcoming_tasks.each do |task| %>
            <div class="border-l-4 <%= task.priority == 'high' ? 'border-red-400' : task.priority == 'medium' ? 'border-yellow-400' : 'border-blue-400' %> bg-gray-50 p-4">
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900"><%= task.title %></p>
                  <% if task.description.present? %>
                    <p class="text-sm text-gray-600 mt-1"><%= truncate(task.description, length: 100) %></p>
                  <% end %>
                  <div class="mt-2 flex items-center space-x-4 text-xs text-gray-500">
                    <% if task.scheduled_at.present? %>
                      <span><%= task.scheduled_at.in_time_zone(current_user.tz).strftime("%b %d, %I:%M %p") %></span>
                    <% else %>
                      <span class="text-purple-600 font-medium">Open-ended</span>
                    <% end %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                      <%= task.task_type.titleize %>
                    </span>
                    <% if task.assigned_to %>
                      <span class="text-green-600">Assigned to: <%= task.assigned_to.friendly_name %></span>
                    <% end %>
                  </div>
                </div>
                <div class="flex items-center space-x-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= task.priority == 'high' ? 'bg-red-100 text-red-800' : task.priority == 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-100 text-blue-800' %>">
                    <%= task.priority.titleize %>
                  </span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Care receiver's reminders for today - simplified -->
  <% if current_user.role_senior? && defined?(@today_occurrences) && @today_occurrences.present? %>
    <% pending_reminders = @today_occurrences.select { |occ| occ.status == 'pending' } %>
    <% if pending_reminders.any? %>
      <div class="bg-white shadow-lg sm:rounded-xl">
        <div class="px-6 py-6 sm:p-8">
          <h3 class="text-3xl font-bold text-gray-900 mb-6">📋 Today's Reminders</h3>
          <div class="space-y-4">
            <% pending_reminders.each do |occ| %>
              <div class="border-l-4 border-yellow-400 bg-yellow-50 p-6 rounded-r-lg shadow-md">
                <div class="flex justify-between items-start">
                  <div class="flex-1">
                    <p class="text-2xl font-bold text-gray-900"><%= occ.reminder.title %></p>
                    <% if occ.reminder.notes.present? %>
                      <p class="text-lg text-gray-700 mt-2"><%= occ.reminder.notes %></p>
                    <% end %>
                    <div class="mt-3">
                      <span class="text-xl font-semibold text-gray-700 bg-white px-4 py-2 rounded-lg shadow-sm">
                        <%= occ.scheduled_at.in_time_zone(current_user.tz).strftime("%I:%M %p") %>
                      </span>
                    </div>
                  </div>
                  <span class="inline-flex items-center px-4 py-2 rounded-full text-base font-medium bg-blue-100 text-blue-800">
                    <%= occ.reminder.category.titleize %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    
    <!-- Completed reminders - collapsed by default -->
    <% completed_reminders = @today_occurrences.select { |occ| occ.status != 'pending' } %>
    <% if completed_reminders.any? %>
      <div class="bg-white shadow sm:rounded-lg">
        <div class="px-4 py-4 sm:p-6">
          <details class="text-gray-600">
            <summary class="cursor-pointer text-lg font-medium hover:text-gray-900">
              ✅ Completed Today (<%= completed_reminders.count %>)
            </summary>
            <div class="mt-4 space-y-2">
              <% completed_reminders.each do |occ| %>
                <div class="border-l-4 border-green-300 bg-green-50 p-3 rounded-r-lg">
                  <div class="flex justify-between items-center">
                    <p class="text-base font-medium text-gray-700"><%= occ.reminder.title %></p>
                    <span class="text-sm text-gray-500"><%= occ.scheduled_at.in_time_zone(current_user.tz).strftime("%I:%M %p") %></span>
                  </div>
                </div>
              <% end %>
            </div>
          </details>
        </div>
      </div>
    <% end %>
  <% end %>

  <!-- Show linked care receivers for caregivers -->
  <% if @linked_seniors.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
        <h3 class="text-sm font-medium text-gray-900">People You're Caring For</h3>
      </div>
      <ul class="divide-y divide-gray-200">
        <% @linked_seniors.each do |link| %>
          <li>
            <%# The row used to be wrapped in a link_to ... do, which put an <a>
                around the "View", "Coverage" and "Unlink" controls inside it.
                Nested interactive elements are invalid HTML, and a keyboard or
                screen-reader user tabbing the row got the outer link as well as
                each control. The name carries the link now instead. %>
            <div class="hover:bg-gray-50">
              <div class="px-4 py-4 sm:px-6">
                <%# Wraps, because at the largest text size the action button was
                    being squeezed past the right edge and rendering as "Vie…".
                    min-w-0 lets the name column actually shrink; without it a
                    flex child refuses to go below its content width and pushes
                    its sibling out instead. %>
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div class="flex-1 min-w-0">
                    <p class="text-lg font-medium truncate">
                      <%= link_to link.senior.display_name, senior_dashboard_path(link.senior.id),
                            class: "text-blue-600 hover:underline" %>
                    </p>
                    <% if link.senior.display_name != link.senior.email %>
                      <p class="text-sm text-gray-500"><%= link.senior.email %></p>
                    <% end %>
                    <%# Wraps and uses a gap rather than ml-4, so the badge and the
                        timezone do not run into each other at the largest text
                        size. The badge says what the permission means, matching
                        the care receiver's own dashboard. %>
                    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= link.permission_manage? ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-800" %>">
                        <%= link.permission_manage? ? "You can make changes" : "You can only look" %>
                      </span>
                      <span>
                        Timezone: <%= link.senior.tz %>
                      </span>
                    </div>
                  </div>
                  <%# Wraps too: three controls at the largest text size do not fit
                      one line beside the name. The parent's gap replaces ml-4. %>
                  <div class="flex flex-wrap gap-2">
                    <%= link_to "View", senior_dashboard_path(link.senior.id), class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
                    <% if FeatureFlag.enabled?(:native_scheduling) %>
                      <%= link_to "Coverage", senior_coverage_path(link.senior), class: "inline-flex items-center px-3 py-2 border border-blue-300 shadow-sm text-sm leading-4 font-medium rounded-md text-blue-700 bg-white hover:bg-blue-50" %>
                    <% end %>
                    <%= button_to "Unlink", unlink_dashboard_path(link.id), method: :delete, data: { confirm: "Are you sure?" }, class: "inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm leading-4 font-medium rounded-md text-red-700 bg-white hover:bg-red-50" %>
                  </div>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <!-- Show linked caregivers for care receivers only -->
  <% if current_user.role_senior? %>
    <%# Loaded up front rather than left as a relation: any? on an unloaded
        relation issues its own EXISTS and the each below then loads the rows
        anyway, so the page paid for three queries where two will do. Measured,
        because the same argument did not hold for the exists? check above. %>
    <% linked_caregivers = current_user.senior_links.includes(:caregiver).where.not(caregiver_id: nil).to_a %>
    <% if linked_caregivers.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
        <h3 class="text-sm font-medium text-gray-900">Your Caregivers</h3>
      </div>
      <ul class="divide-y divide-gray-200">
        <% linked_caregivers.each do |link| %>
          <li class="px-4 py-4 sm:px-6">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <p class="text-lg font-medium text-green-600 truncate">
                  <%= link.caregiver.friendly_name %>
                </p>
                <div class="mt-2 flex items-center text-sm text-gray-500">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= link.permission_manage? ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800" %>">
                    <%= link.permission_manage? ? "Can make changes" : "Can only look" %>
                  </span>
                  <span class="ml-4">
                    Linked <%= time_ago_in_words(link.created_at) %> ago
                  </span>
                </div>
              </div>
              <%# Beside Remove Access, because it is the smaller version of the
                  same decision and has always been the care receiver's to make.
                  Removing somebody entirely was already offered here; limiting
                  what they can do was not. %>
              <div class="ml-4 flex-shrink-0 flex items-center gap-2">
                <%# Plain onclick, not turbo_confirm or data-confirm. This layout
                    loads Tailwind and nothing else — no Turbo, no UJS — so both of
                    those are inert here, which is why Remove Access has been
                    deleting a caregiver without asking since it was written. %>
                <% if link.permission_manage? %>
                  <%= button_to "Limit to looking", caregiver_permission_dashboard_path(link.id), method: :patch,
                        params: { permission: "view" },
                        onclick: "return confirm('#{j "#{link.caregiver.friendly_name} will still see your reminders and tasks, but will not be able to change them. Any phone reminders already agreed carry on."}')",
                        class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
                <% else %>
                  <%= button_to "Let them make changes", caregiver_permission_dashboard_path(link.id), method: :patch,
                        params: { permission: "manage" },
                        onclick: "return confirm('#{j "#{link.caregiver.friendly_name} will be able to set up and change your reminders and tasks, and to arrange phone reminders. They still cannot agree to the calls for you."}')",
                        class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
                <% end %>
                <%# Named rather than emailed: the row above shows friendly_name,
                    so asking about an address the reader may not recognise made
                    the question harder than the decision. %>
                <%= button_to "Remove Access", unlink_dashboard_path(link.id), method: :delete,
                      onclick: "return confirm('#{j "Remove #{link.caregiver.friendly_name}'s access? They will no longer see your reminders or tasks."}')",
                      class: "inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm leading-4 font-medium rounded-md text-red-700 bg-white hover:bg-red-50" %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
    <% end %>
  <% end %>
  
  <% if showing_empty_state %>
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
      <%# Both roles land here, and they need opposite things. A caregiver enters
          somebody's token; a care receiver generates one and shares it. This
          block used to offer the caregiver's action to both, so a care receiver
          with nobody linked was told to pair with a care receiver and sent to a
          form asking for a token only a caregiver would have been given. %>
      <% if current_user.role_senior? %>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No caregivers yet</h3>
        <p class="mt-1 text-sm text-gray-500">Generate a pairing token and share it with whoever helps look after you.</p>
        <div class="mt-6">
          <%= link_to "Generate Pairing Token", generate_token_dashboard_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
        </div>
      <% else %>
        <h3 class="mt-2 text-sm font-medium text-gray-900">Nobody linked yet</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by pairing with someone using their pairing token.</p>
        <div class="mt-6">
          <%= link_to "Pair with a care receiver", pair_dashboard_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
