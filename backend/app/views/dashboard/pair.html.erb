<div class="max-w-md mx-auto">
  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">
        Pair with a care receiver
      </h3>
      <div class="mt-2 max-w-xl text-sm text-gray-500">
        <p>Enter the pairing token provided by the care receiver to link their account.</p>
      </div>
      <div class="mt-5">
        <%= form_with url: pair_dashboard_path, method: :post, class: "space-y-4" do |f| %>
          <div>
            <%= f.label :token, "Pairing Token", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_field :token, required: true, autofocus: true, placeholder: "Enter pairing token", class: "field mt-1 block w-full" %>
          </div>
          <div class="flex space-x-3">
            <%= f.submit "Pair", class: "button button-primary" %>
            <%= link_to "Cancel", dashboard_path, class: "button button-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
