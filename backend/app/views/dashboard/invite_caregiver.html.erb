<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to #{@senior.display_name}", senior_dashboard_path(@senior), class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
        Invite Another Caregiver
      </h3>
      
      <p class="text-sm text-gray-600 mb-6">
        Invite another caregiver to help with <%= @senior.display_name %>. They will be able to view tasks, reminders, and activity.
      </p>

      <%= form_with url: invite_caregiver_dashboard_path(@senior), method: :post, class: "space-y-6" do |f| %>
        <div>
          <%= label_tag :caregiver_email, "Caregiver Email", class: "block text-sm font-medium text-gray-700" %>
          <%= email_field_tag :caregiver_email, nil, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm",
            placeholder: "caregiver@example.com",
            required: true %>
          <p class="mt-2 text-sm text-gray-500">
            If this email doesn't exist in the system, we'll create a new caregiver account for them.
          </p>
        </div>

        <%# This said the invitee would get view access and that permissions
            could be changed later. Neither was true: invitations now grant the
            same access the inviter has, and no screen has ever existed for
            changing a permission afterwards. Amber rather than blue, because
            handing somebody the ability to arrange telephone calls to another
            person is a thing to read before pressing send, not after. %>
        <div class="bg-amber-50 border-l-4 border-amber-400 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-amber-500" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-amber-800">
                They will be able to do everything you can for <%= @senior.display_name %> —
                including setting up reminders and, for phone reminders, changing the
                number <%= @senior.display_name %> is called on.
                <strong>There is no way to reduce that afterwards</strong>, and only
                <%= @senior.display_name %> can remove them, so invite people you would
                trust with the telephone.
              </p>
              <p class="mt-2 text-sm text-amber-800">
                What they cannot do is agree to the calls on
                <%= @senior.display_name %>'s behalf — that still takes
                <%= @senior.display_name %> answering a call and pressing a key.
              </p>
            </div>
          </div>
        </div>

        <div class="flex justify-end space-x-3">
          <%= link_to "Cancel", senior_dashboard_path(@senior), class: "inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
          <%= submit_tag "Send Invitation", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
