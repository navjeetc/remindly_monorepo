<% content_for :title, "Public page traffic" %>

<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h2 class="text-3xl font-bold text-gray-900">Public page traffic</h2>
    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
      Admin Panel
    </span>
  </div>

  <div class="bg-white shadow sm:rounded-lg p-4">
    <%= form_with url: admin_traffic_index_path, method: :get, class: "flex items-end gap-4" do |f| %>
      <div>
        <label for="days" class="block text-sm font-medium text-gray-700 mb-1">Period</label>
        <%= f.select :days,
          options_for_select([ [ "Last 7 days", 7 ], [ "Last 30 days", 30 ], [ "Last 90 days", 90 ] ], @days),
          {},
          class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
      </div>
      <%= f.submit "Apply", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 cursor-pointer" %>
      <p class="text-sm text-gray-500 ml-auto">Since <%= @since.strftime("%d %b %Y") %></p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white shadow sm:rounded-lg p-4">
      <p class="text-sm font-medium text-gray-500">Human views</p>
      <p class="mt-1 text-3xl font-bold text-gray-900"><%= number_with_delimiter(@human_views) %></p>
    </div>
    <div class="bg-white shadow sm:rounded-lg p-4">
      <p class="text-sm font-medium text-gray-500">From another site</p>
      <p class="mt-1 text-3xl font-bold text-gray-900"><%= number_with_delimiter(@referred_views) %></p>
    </div>
    <div class="bg-white shadow sm:rounded-lg p-4">
      <p class="text-sm font-medium text-gray-500">Bots and crawlers</p>
      <p class="mt-1 text-3xl font-bold text-gray-400"><%= number_with_delimiter(@bot_views) %></p>
    </div>
  </div>

  <%#
    The table this page exists for. Everything else is context; this is the one
    that answers whether a post, a link or a mention sent real people.
  %>
  <div class="bg-white shadow sm:rounded-lg p-4">
    <h3 class="text-lg font-semibold text-gray-900 mb-1">Where people came from</h3>
    <p class="text-sm text-gray-500 mb-3">
      Human views referred by another site. Links shared with a
      <code class="text-xs bg-gray-100 px-1 rounded">?from=</code> tag also appear
      under campaign tags below.
    </p>

    <% if @by_referrer.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Site</th>
            <th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Views</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @by_referrer.each do |host, total| %>
            <tr>
              <td class="px-3 py-2 text-sm text-gray-900"><%= host %></td>
              <td class="px-3 py-2 text-sm text-gray-900 text-right font-medium"><%= number_with_delimiter(total) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-500 py-2">
        Nothing yet — no human view in this period arrived with a referring site.
        Direct visits and links from apps that strip the referrer look like this too.
      </p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div class="bg-white shadow sm:rounded-lg p-4">
      <h3 class="text-lg font-semibold text-gray-900 mb-3">Campaign tags</h3>
      <% if @by_source.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <tbody class="divide-y divide-gray-100">
            <% @by_source.each do |source, total| %>
              <tr>
                <td class="px-3 py-2 text-sm text-gray-900"><%= source %></td>
                <td class="px-3 py-2 text-sm text-gray-900 text-right font-medium"><%= number_with_delimiter(total) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-sm text-gray-500">
          None yet. Add <code class="text-xs bg-gray-100 px-1 rounded">?from=somewhere</code>
          to a link before you share it and it will be counted here, even when the
          referrer is stripped.
        </p>
      <% end %>
    </div>

    <div class="bg-white shadow sm:rounded-lg p-4">
      <h3 class="text-lg font-semibold text-gray-900 mb-3">Most read pages</h3>
      <% if @by_path.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <tbody class="divide-y divide-gray-100">
            <% @by_path.each do |path, total| %>
              <tr>
                <td class="px-3 py-2 text-sm text-gray-900"><%= path %></td>
                <td class="px-3 py-2 text-sm text-gray-900 text-right font-medium"><%= number_with_delimiter(total) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-sm text-gray-500">No human views recorded yet.</p>
      <% end %>
    </div>
  </div>

  <div class="bg-white shadow sm:rounded-lg p-4">
    <h3 class="text-lg font-semibold text-gray-900 mb-3">By day</h3>
    <% if @by_day.any? %>
      <% peak = @by_day.map(&:last).max %>
      <table class="min-w-full">
        <tbody>
          <% @by_day.each do |day, total| %>
            <tr>
              <td class="px-3 py-1 text-sm text-gray-500 w-32"><%= day.strftime("%a %d %b") %></td>
              <td class="px-3 py-1 w-full">
                <%# A bar rather than a chart: one dependency-free div that makes a
                    spike on the day something was posted obvious at a glance. %>
                <div class="bg-blue-500 h-4 rounded" style="width: <%= peak.zero? ? 0 : (total * 100.0 / peak).round %>%"></div>
              </td>
              <td class="px-3 py-1 text-sm text-gray-900 text-right font-medium w-16"><%= number_with_delimiter(total) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-500">No human views recorded yet.</p>
    <% end %>
  </div>

  <p class="text-sm text-gray-500">
    Counts only. No cookie is set, and no IP address, user agent or visitor
    identifier is stored — see <%= link_to "the privacy policy", privacy_path, class: "text-blue-600 hover:underline" %>.
    Rows are deleted after 90 days.
  </p>
</div>
